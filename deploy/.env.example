# Copy to deploy/.env and fill in. deploy/.env is git-ignored: it holds secrets.

# --- Shop ---
STORE_NAME=My Shop
# Comma-separated, from: fa,en,hy,de,ar
STORE_LOCALES=fa,en
DEFAULT_LOCALE=fa
# Public address of the shop (https:// in production enables HSTS and upgrade-insecure-requests).
SITE_URL=https://shop.example.com
# Only the real production shop: "true". Test/staging instances must stay "false" (noindex everywhere).
SEO_ALLOW_INDEXING=false

# Region for phone numbers typed without a country code (IR, AM, DE, ...).
PHONE_REGION=IR

# --- Sign-up and sign-in ---
AUTH_EMAIL_SIGN_UP=true
# New numbers may create an account when signing in by SMS code (needs an SMS provider below).
AUTH_PHONE_SIGN_UP=true
# false only for a plain-HTTP test instance
AUTH_SECURE_COOKIES=true

# --- Email (account confirmation, password reset) ---
EMAIL_DELIVERY=Smtp
EMAIL_FROM_ADDRESS=no-reply@shop.example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Sign-in with Google / Facebook / Microsoft (optional; leave empty to hide a provider; keep empty for Iran) ---
# In each provider's console register this redirect URI (replace the host):
#   https://shop.example.com/api/v1/account/external/<google|facebook|microsoft>/oauth-callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Security ---
# true: staff (Manager/Warehouse/Accountant/Admin) must sign in with an authenticator app to use their permissions
REQUIRE_STAFF_TWO_FACTOR=false

# --- SMS (optional; without it, sign-in by code and phone sign-up are off) ---
# None | Kavenegar | SmsIr | Twilio   (Iran: Kavenegar or SmsIr; Europe/Armenia: Twilio)
SMS_PROVIDER=None
# Kavenegar: create a "Verify Lookup" template whose %token% is the code; end it with the WebOTP line
# "@<your domain> #%token%" so Android phones can fill the code in automatically.
KAVENEGAR_API_KEY=
KAVENEGAR_VERIFY_TEMPLATE=
# SMS.ir: create a "Verify" template with a parameter for the code.
SMSIR_API_KEY=
SMSIR_VERIFY_TEMPLATE_ID=0
SMSIR_CODE_PARAMETER=Code
# Twilio: sender number (E.164) or a Messaging Service SID.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# --- First admin account (created on first start; change the password after logging in) ---
ADMIN_EMAIL=admin@shop.example.com
ADMIN_PASSWORD=

# --- Database ---
POSTGRES_DB=onlineshop
POSTGRES_USER=onlineshop
# Long random value, e.g. `openssl rand -base64 32`
POSTGRES_PASSWORD=

# --- Web ---
WEB_PORT=3000
# Shared secret for POST /api/revalidate (cache refresh), e.g. `openssl rand -hex 32`
REVALIDATE_SECRET=

# --- Images (CI publishes to a registry reachable from the hosting country) ---
REGISTRY=onlineshop
IMAGE_TAG=latest
