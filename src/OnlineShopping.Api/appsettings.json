{
  "Database": {
    "Provider": "PostgreSql",
    "MigrateOnStartup": false
  },
  "Store": {
    "Name": "Online Shop",
    "DefaultLocale": "fa",
    "Locales": "fa,en,hy,de,ar",
    "PublicUrl": "https://shop.example.com",
    "PhoneRegion": "IR",
    "ShippingCountries": "",
    "GuestCheckout": true
  },
  "RateLimiting": {
    "PermitPerWindow": 300,
    "WindowSeconds": 60,
    "AuthPermitPerWindow": 10
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "Auth": {
    "EmailSignUp": true,
    "PhoneSignUp": true,
    "SecureCookies": true,
    "RememberMeDays": 14,
    "ReauthenticationMinutes": 10,
    "External": {
      "Google": { "ClientId": "", "ClientSecret": "" },
      "Facebook": { "ClientId": "", "ClientSecret": "" },
      "Microsoft": { "ClientId": "", "ClientSecret": "" }
    }
  },
  "Email": {
    "Delivery": "Smtp",
    "FromAddress": "no-reply@shop.example.com",
    "SmtpPort": 587,
    "SmtpUseTls": true
  },
  "Security": {
    "RequireStaffTwoFactor": false
  },
  "Sms": {
    "Provider": "None"
  },
  "PhoneCodes": {
    "Length": 6,
    "LifetimeSeconds": 180,
    "ResendCooldownSeconds": 60,
    "MaxAttempts": 5,
    "MaxPerHour": 5
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
