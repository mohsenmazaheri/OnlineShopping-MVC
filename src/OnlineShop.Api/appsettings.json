{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=onlineshop;Username=onlineshop"
  },
  "Database": {
    "Provider": "PostgreSql",
    "MigrateOnStartup": false
  },
  "Store": {
    "Name": "Online Shop",
    "DefaultLocale": "fa",
    "Locales": "fa,en,hy,de,ar"
  },
  "RateLimiting": {
    "PermitPerWindow": 300,
    "WindowSeconds": 60
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
