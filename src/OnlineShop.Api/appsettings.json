{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=onlineshop;Username=onlineshop"
  },
  "Database": {
    "Provider": "PostgreSql",
    "MigrateOnStartup": false
  },
  "Store": {
    "Name": "Online Shop",
    "DefaultLocale": "fa",
    "Locales": "fa,en,hy,de,ar",
    "PublicUrl": "https://shop.example.com",
    "PhoneRegion": "IR"
  },
  "RateLimiting": {
    "PermitPerWindow": 300,
    "WindowSeconds": 60,
    "AuthPermitPerWindow": 10
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "Auth": {
    "EmailSignUp": true,
    "PhoneSignUp": true,
    "SecureCookies": true,
    "RememberMeDays": 14
  },
  "Email": {
    "Delivery": "Smtp",
    "FromAddress": "no-reply@shop.example.com",
    "SmtpPort": 587,
    "SmtpUseTls": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
