{
  "openapi": "3.1.1",
  "info": {
    "title": "OnlineShop.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/store": {
      "get": {
        "tags": [
          "Storefront"
        ],
        "summary": "Store name, the locales it offers and the available sign-up methods.",
        "operationId": "GetStoreInfo",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoreInfoResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/catalog/categories": {
      "get": {
        "tags": [
          "Storefront"
        ],
        "summary": "All categories with their sub-categories, for menus and the home page.",
        "operationId": "GetCategoryMenu",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CategorySummary"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/catalog/categories/{slug}": {
      "get": {
        "tags": [
          "Storefront"
        ],
        "summary": "One category by its slug.",
        "operationId": "GetCategoryBySlug",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategorySummary"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/account/register": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Create a customer account with an email or mobile number and sign in.",
        "operationId": "Register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUser"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/account/login": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Sign in with email or mobile number and password.",
        "operationId": "Login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUser"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/account/logout": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Sign out (clears the session cookie).",
        "operationId": "Logout",
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/v1/account/me": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "The signed-in user, with roles and permissions.",
        "operationId": "GetCurrentUser",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUser"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/account/phone/send-code": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Text a one-time sign-in code to a mobile number (same answer whether or not it has an account).",
        "operationId": "SendPhoneSignInCode",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendPhoneCodeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PhoneCodeSent"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/account/phone/sign-in": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Sign in with the SMS code; a new number gets a customer account.",
        "operationId": "PhoneSignIn",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PhoneSignInRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PhoneSignInResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/account/phone/add/send-code": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Text a code to a number the signed-in user wants to add.",
        "operationId": "SendAddPhoneCode",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendPhoneCodeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PhoneCodeSent"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/account/phone/add/confirm": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Save the number as the user's verified phone with the SMS code.",
        "operationId": "ConfirmAddPhone",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmPhoneRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUser"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/account/confirm-email": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Confirm an email address with the token from the confirmation email.",
        "operationId": "ConfirmEmail",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmEmailRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/account/resend-confirmation": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Send the confirmation email again to the signed-in user.",
        "operationId": "ResendEmailConfirmation",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/account/forgot-password": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Email a password reset link, if an account uses this email.",
        "operationId": "ForgotPassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotPasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/account/reset-password": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Set a new password with the token from the reset email; signs out all other sessions.",
        "operationId": "ResetPassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/account/external": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Providers this shop offers and the ones linked to the signed-in account.",
        "operationId": "GetExternalLogins",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExternalLoginsView"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/account/external/{provider}/start": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Browser navigation: redirects to the provider's sign-in page.",
        "operationId": "StartExternalSignIn",
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "returnUrl",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "locale",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/account/external/callback": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Browser navigation: end of the provider round trip; signs in and redirects into the storefront.",
        "operationId": "ExternalSignInCallback",
        "parameters": [
          {
            "name": "returnUrl",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "locale",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/account/external/{provider}/link": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Browser navigation: link a provider to the signed-in account.",
        "operationId": "StartExternalLink",
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "locale",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/account/external/link-callback": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Browser navigation: end of the link round trip.",
        "operationId": "ExternalLinkCallback",
        "parameters": [
          {
            "name": "locale",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/account/external/{provider}/unlink": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Unlink a provider (refused when it is the account's only way to sign in).",
        "operationId": "UnlinkExternalLogin",
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExternalLoginsView"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/account/2fa/verify": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Complete a sign-in with the authenticator app's code.",
        "operationId": "TwoFactorSignIn",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TwoFactorSignInRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUser"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/account/2fa/recovery": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Complete a sign-in with a one-time recovery code.",
        "operationId": "RecoveryCodeSignIn",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecoveryCodeSignInRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUser"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/account/2fa": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Whether two-step sign-in is on, recovery codes left, and whether it is required for this account.",
        "operationId": "GetTwoFactorStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TwoFactorStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/account/2fa/setup": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "The key and otpauth:// URI (QR code) for the authenticator app.",
        "operationId": "BeginTwoFactorSetup",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticatorSetup"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/account/2fa/enable": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Turn on two-step sign-in with a first code from the app; returns recovery codes (shown once).",
        "operationId": "EnableTwoFactor",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TwoFactorCodeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecoveryCodes"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/account/2fa/disable": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Turn off two-step sign-in (needs a current code; refused for staff when it is required).",
        "operationId": "DisableTwoFactor",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TwoFactorCodeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/account/2fa/recovery-codes": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Replace all recovery codes (needs a current code).",
        "operationId": "RegenerateRecoveryCodes",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TwoFactorCodeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecoveryCodes"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/account/2fa/forget-device": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Ask for the second step again on this device.",
        "operationId": "ForgetTwoFactorDevice",
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthenticatorSetup": {
        "required": [
          "sharedKey",
          "authenticatorUri"
        ],
        "type": "object",
        "properties": {
          "sharedKey": {
            "type": "string"
          },
          "authenticatorUri": {
            "type": "string"
          }
        }
      },
      "CategorySummary": {
        "required": [
          "id",
          "name",
          "slug",
          "subCategories"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "subCategories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SubCategorySummary"
            }
          }
        }
      },
      "ConfirmEmailRequest": {
        "required": [
          "userId",
          "token"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "token": {
            "type": "string"
          }
        }
      },
      "ConfirmPhoneRequest": {
        "required": [
          "phone",
          "code"
        ],
        "type": "object",
        "properties": {
          "phone": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "CurrentUser": {
        "required": [
          "id",
          "displayName",
          "email",
          "emailConfirmed",
          "phoneNumber",
          "phoneNumberConfirmed",
          "preferredLocale",
          "roles",
          "permissions"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "displayName": {
            "type": [
              "null",
              "string"
            ]
          },
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "emailConfirmed": {
            "type": "boolean"
          },
          "phoneNumber": {
            "type": [
              "null",
              "string"
            ]
          },
          "phoneNumberConfirmed": {
            "type": "boolean"
          },
          "preferredLocale": {
            "type": [
              "null",
              "string"
            ]
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
