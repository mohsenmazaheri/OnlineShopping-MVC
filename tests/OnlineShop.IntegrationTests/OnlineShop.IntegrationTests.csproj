  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\OnlineShop.Api\OnlineShop.Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
